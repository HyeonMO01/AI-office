# Expo public values. These are included in the app bundle.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_EAS_PROJECT_ID=

# Unified FastAPI backend URL.
# Local web: http://localhost:8000
# Physical device: http://<PC_LAN_IP>:8000
# Deploy: https://...
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_PROXY_TOKEN=

# Optional client-side observability.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_MONITORING_ENDPOINT=

# Server-only secrets. Do not expose these in a production client bundle.
# The unified FastAPI backend loads these values from this file for local development.
OPENAI_API_KEY=
NAVER_SHOPPING_CLIENT_ID=
NAVER_SHOPPING_CLIENT_SECRET=
OPENWEATHER_API_KEY=
REPLICATE_API_TOKEN=
PROXY_TOKEN=
CORS_ALLOWED_ORIGINS=
PROXY_VERSION=1
